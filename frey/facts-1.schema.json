{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.innocraft.frey:schema:models:facts:1",
  "title": "Frey model facts table, format 1",
  "description": "configs/models-facts.json (T-0112, AD132 A): generated by src/frey/tools/models_facts.py from a models.dev commit (MIT) and compiled into frey-vendors; a newer copy may sit in ~/.frey/cache/models-facts/. Facts only — limits, prices, modalities, dates, reported benchmarks. A file that does not fit is refused whole and the previous one kept. Nothing here turns a permission, a tool or a prompt on; the request switches stay the quirk table's (configs/models.toml).",
  "type": "object",
  "required": [
    "format",
    "source",
    "upstream",
    "upstream_commit",
    "generated_at",
    "overrides_version",
    "license",
    "providers"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "source": {
      "const": "models.dev"
    },
    "upstream": {
      "type": "string",
      "pattern": "^https://"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "The upstream commit's time (so the same commit gives the same bytes)."
    },
    "overrides_version": {
      "type": "integer",
      "minimum": 0
    },
    "license": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "description": "By Frey preset name (configs/vendors.toml).",
      "additionalProperties": {
        "$ref": "#/$defs/Provider"
      }
    },
    "interface_source": {
      "type": "string",
      "description": "T-0173: where the interface layer came from (pi-ai <version>, its license file)."
    },
    "sources": {
      "type": "object",
      "description": "T-0174 (AD159): the day (or version) each source of the table was taken: models.dev (its upstream commit's day), pi, openrouter, litellm, aider. The table's date for the release check is the oldest taken day but models.dev's (tools/models_sources.py age).",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Provider": {
      "type": "object",
      "required": [
        "models_dev",
        "models"
      ],
      "properties": {
        "models_dev": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Model"
          }
        },
        "interface_defaults": {
          "description": "T-0173: what every merged model of the preset has alike, per protocol — what a model the table does not have yet gets (never thinking levels).",
          "type": "object",
          "propertyNames": {
            "enum": [
              "messages_api",
              "openai_compat",
              "responses",
              "gemini"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/Interface"
          }
        }
      },
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "alpha",
            "beta",
            "deprecated"
          ]
        },
        "release_date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "knowledge": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "open_weights": {
          "type": "boolean"
        },
        "limit": {
          "type": "object",
          "properties": {
            "context": {
              "type": "integer",
              "minimum": 1
            },
            "input": {
              "type": "integer",
              "minimum": 1
            },
            "output": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "modalities": {
          "type": "object",
          "properties": {
            "input": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Benchmark"
          }
        },
        "interface": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "messages_api",
              "openai_compat",
              "responses",
              "gemini"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/Interface"
          }
        },
        "lifecycle": {
          "type": "object",
          "description": "T-0174: when the model retires and what replaces it (LiteLLM's deprecation_date, successor_model, deprecation_source).",
          "required": [
            "retires",
            "from"
          ],
          "properties": {
            "retires": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "successor": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "cache_min_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "T-0174: the shortest prompt the vendor's cache takes (LiteLLM's prompt_cache_min_tokens)."
        },
        "parallel_tool_calls": {
          "type": "boolean",
          "description": "T-0174: the model can call several tools in one response (LiteLLM's supports_parallel_function_calling)."
        }
      },
      "additionalProperties": false
    },
    "Cost": {
      "type": "object",
      "required": [
        "currency",
        "per_tokens"
      ],
      "description": "USD per million tokens (per `unit` when models.dev prices another unit — Frey does not count those).",
      "properties": {
        "currency": {
          "const": "USD"
        },
        "per_tokens": {
          "const": 1000000
        },
        "input": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "type": "number",
          "minimum": 0
        },
        "reasoning": {
          "type": "number",
          "minimum": 0
        },
        "cache_read": {
          "type": "number",
          "minimum": 0
        },
        "cache_write": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "input_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Override"
          }
        },
        "output_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Override"
          }
        },
        "multipliers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "factor"
            ],
            "properties": {
              "when": {
                "type": "object",
                "description": "A models.dev condition as it wrote it (context / utc_hours / utc_days / date / service_tier / region / holiday, and all / any / not). Frey decides the ones it can (frey_vendors::facts)."
              },
              "factor": {
                "type": "number",
                "minimum": 0,
                "description": "Multiplies every text price while `when` holds (models.dev: a factor cannot be negative; 0 is free)."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "Override": {
      "type": "object",
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "type": "object",
          "description": "A models.dev condition as it wrote it (context / utc_hours / utc_days / date / service_tier / region / holiday, and all / any / not). Frey decides the ones it can (frey_vendors::facts)."
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "cache_read": {
          "type": "number",
          "minimum": 0
        },
        "cache_write": {
          "type": "number",
          "minimum": 0
        },
        "reasoning": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "One models.dev override: the prices it sets while its condition holds (models.dev merges the matching ones field by field, in order). The input's: price, cache_read, cache_write; the output's: price, reasoning."
    },
    "Benchmark": {
      "type": "object",
      "required": [
        "name",
        "score",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Interface": {
      "type": "object",
      "description": "T-0173 (AD159): how to call the model on one protocol, from pi-ai (tools/models_pi.py). Optional: a model without it is called with the protocol defaults and the quirk table. T-0174: OpenRouter's own thinking levels for the openrouter preset's models (thinking_from).",
      "properties": {
        "thinking_levels": {
          "type": "array",
          "description": "The levels the model has, in order: [pi level name, the value the vendor takes].",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "thinking_off": {
          "type": "string"
        },
        "thinking_always_on": {
          "type": "boolean"
        },
        "thinking_format": {
          "type": "string"
        },
        "supports_reasoning_effort": {
          "type": "boolean"
        },
        "reasoning_on_assistant_messages": {
          "type": "boolean"
        },
        "max_tokens_field": {
          "type": "string",
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "supports_developer_role": {
          "type": "boolean"
        },
        "supports_strict_mode": {
          "type": "boolean"
        },
        "session_affinity_headers": {
          "type": "boolean"
        },
        "session_affinity_format": {
          "type": "string"
        },
        "cache_control_format": {
          "type": "string"
        },
        "other": {
          "type": "object",
          "description": "The rest of pi's compat fields, as pi writes them (kept, not read)."
        },
        "context_window": {
          "type": "integer",
          "minimum": 1
        },
        "max_output": {
          "type": "integer",
          "minimum": 1
        },
        "reasoning": {
          "type": "boolean"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "thinking_from": {
          "type": "string",
          "minLength": 1,
          "description": "T-0174: where thinking_levels came from when not the interface's `from` (OpenRouter's own list for its models)."
        },
        "thinking_default": {
          "type": "string",
          "minLength": 1,
          "description": "T-0174: the level the endpoint uses when none is sent (OpenRouter's default_effort)."
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    }
  }
}
