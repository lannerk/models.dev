{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai.innocraft.frey:schema:models:facts:1",
  "title": "Frey model facts table, format 1",
  "description": "configs/models-facts.json (T-0112, AD132 A): generated by src/frey/tools/models_facts.py from a models.dev commit (MIT) and compiled into frey-vendors; a newer copy may sit in ~/.frey/cache/models-facts/. Facts only — limits, prices, modalities, dates, reported benchmarks. A file that does not fit is refused whole and the previous one kept. Nothing here turns a permission, a tool or a prompt on; the request switches stay the quirk table's (configs/models.toml).",
  "type": "object",
  "required": [
    "format",
    "source",
    "upstream",
    "upstream_commit",
    "generated_at",
    "overrides_version",
    "license",
    "providers"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "source": {
      "const": "models.dev"
    },
    "upstream": {
      "type": "string",
      "pattern": "^https://"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "The upstream commit's time (so the same commit gives the same bytes)."
    },
    "overrides_version": {
      "type": "integer",
      "minimum": 0
    },
    "license": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "description": "By Frey preset name (configs/vendors.toml).",
      "additionalProperties": {
        "$ref": "#/$defs/Provider"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Provider": {
      "type": "object",
      "required": [
        "models_dev",
        "models"
      ],
      "properties": {
        "models_dev": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Model"
          }
        }
      },
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "alpha",
            "beta",
            "deprecated"
          ]
        },
        "release_date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "knowledge": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "open_weights": {
          "type": "boolean"
        },
        "limit": {
          "type": "object",
          "properties": {
            "context": {
              "type": "integer",
              "minimum": 1
            },
            "input": {
              "type": "integer",
              "minimum": 1
            },
            "output": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "modalities": {
          "type": "object",
          "properties": {
            "input": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Benchmark"
          }
        }
      },
      "additionalProperties": false
    },
    "Cost": {
      "type": "object",
      "required": [
        "currency",
        "per_tokens"
      ],
      "description": "USD per million tokens (per `unit` when models.dev prices another unit — Frey does not count those).",
      "properties": {
        "currency": {
          "const": "USD"
        },
        "per_tokens": {
          "const": 1000000
        },
        "input": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "type": "number",
          "minimum": 0
        },
        "reasoning": {
          "type": "number",
          "minimum": 0
        },
        "cache_read": {
          "type": "number",
          "minimum": 0
        },
        "cache_write": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "input_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Override"
          }
        },
        "output_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Override"
          }
        },
        "multipliers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "factor"
            ],
            "properties": {
              "when": {
                "type": "object",
                "description": "A models.dev condition as it wrote it (context / utc_hours / utc_days / date / service_tier / region / holiday, and all / any / not). Frey decides the ones it can (frey_vendors::facts)."
              },
              "factor": {
                "type": "number",
                "minimum": 0,
                "description": "Multiplies every text price while `when` holds (models.dev: a factor cannot be negative; 0 is free)."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "Override": {
      "type": "object",
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "type": "object",
          "description": "A models.dev condition as it wrote it (context / utc_hours / utc_days / date / service_tier / region / holiday, and all / any / not). Frey decides the ones it can (frey_vendors::facts)."
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "cache_read": {
          "type": "number",
          "minimum": 0
        },
        "cache_write": {
          "type": "number",
          "minimum": 0
        },
        "reasoning": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "One models.dev override: the prices it sets while its condition holds (models.dev merges the matching ones field by field, in order). The input's: price, cache_read, cache_write; the output's: price, reasoning."
    },
    "Benchmark": {
      "type": "object",
      "required": [
        "name",
        "score",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
